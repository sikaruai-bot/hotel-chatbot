# ==============================================================================
# HOTEL SHERPA SOUL - OMNICHANNEL CHATBOT & CRM CONFIGURATION
# ==============================================================================

# Application Base URL
APP_URL=http://localhost:3000

# Database Connection
# Default for zero-config local development: SQLite
DATABASE_URL="file:./dev.db"
# For Production Supabase / PostgreSQL:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public"

# Meta App & Verification
# Configured in Meta for Developers > App Dashboard > Webhooks
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=sherpa_soul_webhook_verify_token_2026

# WhatsApp Business Cloud API
# Found under WhatsApp > API Setup in Meta Developer Dashboard
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here

# Facebook Messenger Platform
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Instagram Direct Message Platform
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# AI Engine Configuration
# Providers: 'auto' | 'rule-based' | 'openai' | 'gemini'
# If AI_API_KEY is empty or provider is 'rule-based', the system uses the 100% grounded deterministic knowledge engine
AI_PROVIDER=auto
AI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Hotel Front Desk & Notification Settings
HOTEL_NOTIFICATION_EMAIL=info@hotelsherpasoul.com
HOTEL_FRONTDESK_PHONE="+977-1-4530311"
HOTEL_WHATSAPP_PHONE="+977-9851068219"

# Security & Staff Authentication
ADMIN_SECRET_KEY=sherpa_soul_admin_secret_2026
